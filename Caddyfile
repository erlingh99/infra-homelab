# homelab/caddy/Caddyfile

{
	acme_ca https://step-ca:9000/acme/acme/directory
	acme_ca_root /etc/caddy/root_ca.crt
	cert_lifetime 24h
}

# Route pihole to host networking
pi.hole pihole.lan {
	reverse_proxy 192.168.0.2:8080
}

leafy.lan {
	reverse_proxy leafy_backend:80
}

alarmy.lan {
	reverse_proxy alarmy_backend:80
}
